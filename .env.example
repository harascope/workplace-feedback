# --- Anthropic ---
# サーバー側でのみ使用する。NEXT_PUBLIC_ を付けないこと。
# 未設定の場合は src/lib/ai/stub.ts の簡易処理で動く（画面に「スタブ動作中」と出る）。
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# Supabase ダッシュボード → Settings → API から取得する。
# SERVICE_ROLE_KEY は RLS をバイパスする強い権限。絶対に公開しないこと。
# どちらも NEXT_PUBLIC_ を付けない（サーバー側からのみ使う）。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
